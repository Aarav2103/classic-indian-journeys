# Mongo connection string. Least-privilege DB user in prod, and lock the Atlas
# IP list down to the server.
MONGO_URI=

# openssl rand -base64 48
# Server won't boot on a weak secret, wants 32+ chars in production.
JWT_SECRET=

PORT=8000

# Comma-separated CORS origins. Has to be the real frontend origin in prod, the
# server refuses to boot on localhost there.
CLIENT_URL=http://localhost:3000

# "production" on the deploy host. stricter config checks + combined logs
NODE_ENV=development

# used by npm run seed:admin. this account can edit all site content
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=

# Optional, booking/enquiry/newsletter alerts. Blank is fine, app runs without.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ADMIN_NOTIFY_EMAIL=

# Optional. Powers NL search, the planner and the concierge. Free key at
# https://aistudio.google.com/apikey. Blank means the AI endpoints 503 and the
# UI falls back to keyword filters.
GEMINI_API_KEY=
# Blank uses the code default. flash-lite is picked for the daily cap (500/day,
# 15 RPM) since that's the limit that actually bites. 2.5-flash is more literal
# but only ~20/day free.
GEMINI_MODEL=gemini-3.1-flash-lite

# EMBED_DIM has to match the Atlas vector index dimension
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# Eval only, never used by the app. The concierge eval grades Gemini answers with
# a judge from a different model family (NVIDIA NIM, OpenAI-compatible endpoint)
# so the generator isn't marking its own homework. Free key at
# https://build.nvidia.com. Without it, evals/conciergeEval.js won't run.
NVIDIA_API_KEY=
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
