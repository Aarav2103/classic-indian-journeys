# Production env for docker compose. Copy to .env in the repo root on the server.
# Compose reads it for the ${SITE_ADDRESS} substitution and the api container.

# Atlas cluster. Keep it in ap-south-1, same region as the box.
MONGO_URI=

# openssl rand -base64 48
JWT_SECRET=

# comma-separated, with https://, backend CORS allowlist
CLIENT_URL=https://classicindianjourneys.com,https://www.classicindianjourneys.com

# what Caddy gets certs for. no https:// here
SITE_ADDRESS=classicindianjourneys.com, www.classicindianjourneys.com

NODE_ENV=production

# docker compose run --rm api npm run seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=

# optional, https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# optional, app runs fine without
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ADMIN_NOTIFY_EMAIL=
